generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// USUARIOS Y AUTENTICACIÓN
// ==========================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  name              String?
  username          String?   @unique
  gender            String?
  dateOfBirth       DateTime?
  avatar            String?
  emailVerified     DateTime?
  resetToken        String?
  resetTokenExpires DateTime?

  accounts       Account[]
  stores         Store[]
  refreshTokens  RefreshToken[]
  landingVisitor LandingVisitor?

  // BE-118: multi-catalog support. Points to the store the user last activated.
  activeStoreId String?
  activeStore   Store?  @relation("UserActiveStore", fields: [activeStoreId], references: [id], onDelete: SetNull)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDemo])
  @@index([activeStoreId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// TIENDAS
// ==========================================

model Store {
  id          String  @id @default(cuid())
  slug        String  @unique
  username    String? @unique
  name        String
  description String? @db.Text

  logo    String?
  favicon String?
  banner  String?

  primaryColor    String @default("#3b82f6")
  secondaryColor  String @default("#64748b")
  backgroundColor String @default("#ffffff")
  textColor       String @default("#0f172a")
  font            String @default("Inter")
  template        String @default("minimal")

  whatsappNumbers String[]
  instagramHandle String?
  facebookUrl     String?
  tiktokUrl       String?
  email           String?
  phone           String?
  address         String?
  socialLinks     Json?
  businessHours   Json?

  checkoutConfig   Json?
  currencyConfig   Json?
  whatsappTemplate String? @db.Text
  stockEnabled     Boolean @default(false)
  showBranding     Boolean @default(true)

  customDomain   String? @unique
  domainVerified Boolean @default(false)

  // BE-121: configurable CTA per store
  ctaType  StoreCtaType @default(WHATSAPP)
  ctaLabel String?      @db.VarChar(60)
  ctaUrl   String?

  // BE-123: structured store info
  aboutShort    String?  @db.VarChar(120)
  aboutLong     String?  @db.Text
  locationLat   Decimal? @db.Decimal(10, 7)
  locationLng   Decimal? @db.Decimal(10, 7)
  locationLabel String?  @db.VarChar(120)

  ownerId        String
  owner          User   @relation(fields: [ownerId], references: [id])
  activeForUsers User[] @relation("UserActiveStore")

  products       Product[]
  categories     Category[]
  orders         OrderIntent[]
  visitors       Visitor[]
  analytics      AnalyticsEvent[]
  subscription   Subscription?
  domainAddon    DomainAddon?
  paymentReports PaymentReport[]
  inquiries      Inquiry[]
  paymentMethods StorePaymentMethod[]
  hours          StoreHours[]
  views          StoreView[]
  customRates    StoreCustomRate[]
  socialLinkRows StoreSocialLink[]
  domain         StoreDomain?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([slug])
  @@index([customDomain])
  @@map("stores")
}

// BE-124: per-store social links as a relational table.
// Replaces (long-term) the legacy `Store.socialLinks` JSON. We keep both:
// reads do a lazy hydration from JSON when no rows exist; writes go to this table.
model StoreSocialLink {
  id        String         @id @default(cuid())
  storeId   String
  platform  SocialPlatform
  url       String
  label     String?        @db.VarChar(60)
  sortOrder Int            @default(0)
  visible   Boolean        @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, sortOrder])
  @@index([storeId, visible, sortOrder])
  @@map("store_social_links")
}

enum SocialPlatform {
  IG
  TIKTOK
  FACEBOOK
  TWITTER
  YOUTUBE
  THREADS
  WHATSAPP
}

// BE-122: custom domain hosted by the store. Verified lazily via DNS TXT.
model StoreDomain {
  id                String            @id @default(cuid())
  storeId           String            @unique
  domain            String            @unique
  verificationToken String            @unique
  status            StoreDomainStatus @default(PENDING)
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("store_domains")
}

enum StoreDomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model StoreHours {
  id        String  @id @default(cuid())
  storeId   String
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime  String // "HH:mm"
  closeTime String // "HH:mm"
  closed    Boolean @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
  @@map("store_hours")
}

model StoreView {
  id          String  @id @default(cuid())
  storeId     String
  sessionId   String
  referrer    String?
  country     String?
  device      String?
  scrollDepth Int?
  timeOnPage  Int?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("store_views")
}

model SlugMiss {
  id        String   @id @default(cuid())
  slug      String
  ip        String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([slug])
  @@index([createdAt])
  @@map("slug_misses")
}

// ==========================================
// PRODUCTOS
// ==========================================

model Product {
  id      String @id @default(cuid())
  storeId String

  name        String
  slug        String
  tagline     String? @db.VarChar(80)
  description String? @db.Text

  basePrice      Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  priceCurrency  String   @default("USD")

  images String[]
  videos String[]

  stock Int?
  sku   String?

  isVisible  Boolean @default(true)
  isFeatured Boolean @default(false)
  isOnSale   Boolean @default(false)

  sortOrder Int @default(0)

  store          Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categories     CategoriesOnProducts[]
  attributes     ProductAttribute[]
  variants       ProductVariant[]
  realEstateData ProductRealEstateData?
  serviceData    ProductServiceData?

  analyticsEvents AnalyticsEvent[]
  orderItems      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, isVisible])
  @@map("products")
}

model ProductRealEstateData {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  bedrooms    Int?
  bathrooms   Int?
  area        Decimal?               @db.Decimal(10, 2)
  listingType RealEstateListingType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_real_estate_data")
}

enum RealEstateListingType {
  SALE
  RENT
}

model ProductServiceData {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  duration Int?
  modality ServiceModality?
  coverage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_service_data")
}

enum ServiceModality {
  IN_PERSON
  ONLINE
  HYBRID
}

model ProductAttribute {
  id        String @id @default(cuid())
  productId String

  name        String
  options     String[]
  type        String   @default("text")
  role        String   @default("variant")
  optionsMeta Json?
  sortOrder   Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  combination     Json
  sku             String?
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)
  stock           Int?
  image           String?
  isAvailable     Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ==========================================
// CATEGORÍAS
// ==========================================

model Category {
  id      String @id @default(cuid())
  storeId String

  name        String
  slug        String
  description String?
  image       String?

  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  store    Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products CategoriesOnProducts[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, parentId])
  @@map("categories")
}

model CategoriesOnProducts {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("categories_on_products")
}

// ==========================================
// ANALYTICS
// ==========================================

model Visitor {
  id        String @id @default(cuid())
  storeId   String
  visitorId String

  ip        String?
  userAgent String?
  country   String?
  city      String?

  isExcluded Boolean @default(false)

  visitCount Int @default(1)

  firstVisit DateTime @default(now())
  lastVisit  DateTime @default(now())

  store  Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  events AnalyticsEvent[]
  orders OrderIntent[]

  @@unique([storeId, visitorId])
  @@index([storeId])
  @@index([storeId, isExcluded])
  @@map("visitors")
}

model AnalyticsEvent {
  id        String  @id @default(cuid())
  storeId   String
  visitorId String?
  productId String?

  type     EventType
  metadata Json?
  isSeeded Boolean   @default(false)

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  visitor Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([storeId, type])
  @@index([storeId, createdAt])
  @@index([productId])
  @@map("analytics_events")
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  REMOVE_FROM_CART
  CHECKOUT_START
  CHECKOUT_COMPLETE
  SEARCH
  CATEGORY_VIEW
}

// ==========================================
// PEDIDOS
// ==========================================

model OrderIntent {
  id        String  @id @default(cuid())
  storeId   String
  visitorId String?

  items OrderItem[]

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // Snapshot de la tasa pública resuelta al crear la orden (lo que vio el cliente).
  rateCodeSnapshot String?
  valueVesSnapshot Decimal? @db.Decimal(14, 4)

  customerName    String?
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  customerNotes   String? @db.Text

  status           OrderStatus  @default(PENDING)
  channel          OrderChannel
  whatsappNumber   String?
  messageGenerated String?      @db.Text

  paymentMethodId String?
  paymentMethod   StorePaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  visitor Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([paymentMethodId])
  @@map("order_intents")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?

  productName String
  variantName String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  order   OrderIntent     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONTACTED
  ACCEPTED
  REJECTED
}

enum OrderChannel {
  WHATSAPP
  INSTAGRAM
}

// ==========================================
// SUSCRIPCIONES
// ==========================================

model Subscription {
  id      String @id @default(cuid())
  storeId String @unique

  plan   Plan               @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?

  trialStart DateTime?
  trialEnd   DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

