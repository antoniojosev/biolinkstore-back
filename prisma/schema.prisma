// ==========================================
// REPORTES DE PAGO
// ==========================================

model PaymentReport {
  id      String @id @default(cuid())
  storeId String

  type       PaymentReportType
  targetPlan String?
  status     PaymentReportStatus @default(PENDING)

  name         String
  phone        String
  bank         String
  transferDate DateTime
  proofUrl     String
  notes        String?  @db.Text

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@map("payment_reports")
}

enum PaymentReportType {
  PLAN_UPGRADE
  DOMAIN
  DESIGN
}

enum PaymentReportStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// SOLICITUDES (diseño / plan personalizado)
// ==========================================

model Inquiry {
  id      String @id @default(cuid())
  storeId String

  type        InquiryType
  method      String // 'whatsapp' | 'email'
  contact     String // phone or email
  description String?     @db.Text

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storeId])
  @@map("inquiries")
}

enum InquiryType {
  DESIGN
  CUSTOM_PLAN
}

// ==========================================
// VISITANTES DE LANDING
// ==========================================

model LandingVisitor {
  id          String @id @default(cuid())
  fingerprint String @unique

  ip        String?
  userAgent String? @db.Text
  referrer  String?
  country   String?
  city      String?
  metadata  Json?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  isExcluded     Boolean        @default(false)
  excludedReason ExcludeReason?

  visitCount Int      @default(1)
  firstVisit DateTime @default(now())
  lastVisit  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isExcluded])
  @@map("landing_visitors")
}

enum ExcludeReason {
  OWNER
  DEMO
  BOT
}

// ==========================================
// PAYMENT METHODS (per-store, merchant-configured)
// ==========================================

model StorePaymentMethod {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  type         PaymentMethodType
  label        String            @db.VarChar(80)
  details      Json
  instructions String?           @db.Text
  enabled      Boolean           @default(true)
  displayOrder Int               @default(0)

  orders OrderIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, enabled, displayOrder])
  @@map("store_payment_methods")
}

enum PaymentMethodType {
  PAGO_MOVIL
  ZELLE
  BINANCE
  TRANSFER
  CASH
  OTHER
}

// ==========================================
// TASAS DE CAMBIO
// ==========================================

model Rate {
  id           String  @id @default(cuid())
  code         String  @unique
  label        String
  baseCurrency String
  sourceUrl    String?
  sourcePath   String?
  isActive     Boolean @default(true)

  snapshots RateSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("rates")
}

model RateSnapshot {
  id        String   @id @default(cuid())
  rateCode  String
  valueVes  Decimal  @db.Decimal(14, 4)
  fetchedAt DateTime @default(now())

  rate Rate @relation(fields: [rateCode], references: [code], onDelete: Cascade)

  @@index([rateCode, fetchedAt(sort: Desc)])
  @@map("rate_snapshots")
}

model StoreCustomRate {
  id      String @id @default(cuid())
  storeId String

  label        String
  baseCurrency String
  mode         CustomRateMode

  valueVes Decimal? @db.Decimal(14, 4)

  formula String?

  sourceUrl     String?
  sourcePath    String?
  lastValue     Decimal?  @db.Decimal(14, 4)
  lastFetchedAt DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@map("store_custom_rates")
}

enum CustomRateMode {
  MANUAL
  FORMULA
  API
}
